# Copy to .env and set only what you want to override. Every variable has a
# default in config.py, so a blank value here (and an absent .env) both fall
# back to it — the defaults are not repeated below to keep the two from
# drifting. Nothing loads this file automatically: export the variables, or run
# through a tool that reads .env for you.

# Where the chat completions endpoint lives. The default is a local llama-server.
AUTOCV_BASE_URL=

# Both empty for a local unauthenticated server. Fill them in when BASE_URL
# points somewhere hosted; the client only sends either one once it is set.
AUTOCV_API_KEY=
AUTOCV_MODEL_NAME=

# Request timeout in seconds.
AUTOCV_TIMEOUT=
# Sampling temperature. Gemma degenerates under greedy decoding, so the default
# keeps sampling on.
AUTOCV_TEMPERATURE=

# Postings transformed at once. Locally this should match llama-server's
# --parallel slot count. Raise it once BASE_URL points somewhere hosted.
AUTOCV_MAX_CONCURRENCY=

# Reasoning effort for every thinking task at once: low, medium or high. Blank
# leaves the server on its own default. Per-task overrides live in config.py.
AUTOCV_REASONING_EFFORT=

# Base, staging and stage output folders. Defaults to data/ next to config.py.
AUTOCV_DATA_DIR=
