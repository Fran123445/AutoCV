# Copy to .env and edit. Values shown are the defaults, so an empty .env and no
# .env at all behave the same. Nothing loads this file automatically: export the
# variables, or run through a tool that reads .env for you.

# Where the chat completions endpoint lives. The local default is llama-server.
AUTOCV_BASE_URL=http://localhost:5001

# Both empty for a local unauthenticated server. Fill them in when BASE_URL
# points somewhere hosted; the client only sends either one once it is set.
AUTOCV_API_KEY=
AUTOCV_MODEL_NAME=

AUTOCV_TIMEOUT=300
# Gemma degenerates under greedy decoding, so sampling stays on.
AUTOCV_TEMPERATURE=0.95

# Postings transformed at once. Locally this should match llama-server's
# --parallel slot count. Raise it once BASE_URL points somewhere hosted.
AUTOCV_MAX_CONCURRENCY=4

# Base, staging and stage output folders. Defaults to data/ next to this file.
AUTOCV_DATA_DIR=
